# ---- Client (exposé dans l'app : uniquement des valeurs publiques) ----
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# URL des Vercel Functions :
#  - en production : https://votre-projet.vercel.app
#  - en local avec Expo Go : http://IP-DE-VOTRE-PC:3000  (vercel dev --listen 3000)
EXPO_PUBLIC_API_URL=

# ---- Serveur uniquement (à saisir dans Vercel > Settings > Environment Variables, jamais dans l'app) ----
# Contenu JSON complet de la clé de compte de service Firebase, sur une seule ligne
FIREBASE_SERVICE_ACCOUNT=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
